# Optional overrides. Copy to .env or export these values in your shell.
# Never place a real license file or credential in Git.

DWC_INPUT_DIR=/absolute/path/to/joint-ev-charging-siting/data/processed
DWC_OUTPUT_DIR=/absolute/path/to/joint-ev-charging-siting/results

# Required only for GIS result reconstruction.
DWC_RESULTS_DIR=/absolute/path/to/Results_run_tag
DWC_HIGHWAY_GDB=/absolute/path/to/project.gdb

# Use only when Gurobi should not use its default license-file search order.
GRB_LICENSE_FILE=/absolute/path/to/gurobi.lic
